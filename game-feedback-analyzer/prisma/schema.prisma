generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id            String   @id @default(cuid())
  name          String
  description   String?
  directionDoc  String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  builds        Build[]
  categories    Category[]
  tasks         Task[]
  crossAnalysis CrossBuildAnalysis?
}

model Category {
  id        String  @id @default(cuid())
  name      String
  group     String?
  order     Int     @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Build {
  id           String    @id @default(cuid())
  name         String
  version      String?
  date         DateTime
  notes        String?
  changes      String?
  testType     String?
  testTarget   String?
  testCount    Int?
  playTime     String?
  caution      String?
  biasProfile  String?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  feedbackFiles FeedbackFile[]
  responses     FeedbackResponse[]
  analysis      BuildAnalysis?
  taskHistories TaskHistory[]
}

model FeedbackFile {
  id             String   @id @default(cuid())
  filename       String
  fileType       String
  fileSize       Int
  rawData        Bytes
  parsedColumns  String?
  rowCount       Int?
  uploadedAt     DateTime @default(now())
  buildId        String
  build          Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
}

model FeedbackResponse {
  id            String   @id @default(cuid())
  respondentId  String?
  text          String
  categories    String?
  sentiment     String?
  language      String?
  confidence    Float?
  summary       String?
  isKeyQuote    Boolean  @default(false)
  analysisJson  String?
  buildId       String
  build         Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  fileId        String?
}

model BuildAnalysis {
  id               String   @id @default(cuid())
  analysisLevel    String
  qualitativeJson  String?
  quantitativeJson String?
  biasJson         String?
  costJson         String?
  analyzedAt       DateTime @default(now())
  buildId          String   @unique
  build            Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
}

model CrossBuildAnalysis {
  id          String   @id @default(cuid())
  resultJson  String
  costJson    String?
  createdAt   DateTime @default(now())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id              String   @id @default(cuid())
  title           String
  description     String?
  section         String?
  currentStatus   String   @default("open")
  priority        String   @default("P1")
  discoveredBuildId String?
  targetBuildId   String?
  order           Int      @default(0)
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  histories       TaskHistory[]
}

model TaskHistory {
  id         String   @id @default(cuid())
  status     String
  note       String?
  evidence   String?
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  buildId    String
  build      Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([taskId, buildId])
}

model APICallLog {
  id           String   @id @default(cuid())
  agent        String
  model        String
  inputTokens  Int
  outputTokens Int
  cachedTokens Int      @default(0)
  costUSD      Float
  buildId      String?
  analysisLevel String?
  timestamp    DateTime @default(now())
}
